<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_border_header"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết đơn rút tiền"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Body Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Transaction Amount Highlight Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tvDialogAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0đ"
                    android:textColor="@color/primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số tiền yêu cầu rút"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvDialogStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Chờ xử lý"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#F57C00"
                    android:background="@drawable/bg_badge_pending"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#EAEAEA" />

            <!-- Information Details Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_withdrawal_details_container"
                android:padding="16dp">

                <!-- Chủ tài khoản -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chủ tài khoản"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvDialogName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGUYEN VAN A"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA" />

                <!-- Ngân hàng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ngân hàng nhận"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvDialogBank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vietcombank"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA" />

                <!-- Số tài khoản -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số tài khoản"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvDialogAccountNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1234567890"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA" />

                <!-- Thời gian -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thời gian tạo"
                        android:textColor="#757575"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvDialogTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026-05-25 14:30"
                        android:textColor="#212121"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Approved Section: Bill Image -->
            <LinearLayout
                android:id="@+id/layoutDialogBill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biên lai chuyển khoản của cửa hàng"
                    android:textColor="#212121"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F8F9FA">

                    <ImageView
                        android:id="@+id/ivDialogBillImage"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Rejected Section: Rejection Reason -->
            <LinearLayout
                android:id="@+id/layoutDialogRejection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lý do từ chối"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDialogRejectionReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rejected"
                    android:padding="12dp"
                    android:text="Sai thông tin số tài khoản"
                    android:textColor="#D32F2F"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Re-create Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRecreateRequest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/custom_btn_muaangay"
                android:text="TẠO MỚI LẠI ĐƠN"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Close Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDialogClose"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_border_item_list"
                android:backgroundTint="#F5F5F5"
                android:text="ĐÓNG"
                android:textColor="#757575"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
