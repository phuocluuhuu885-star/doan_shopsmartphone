<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Chi tiết đơn rút tiền"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/custom_bg_white_gray"
        android:padding="16dp">

        <!-- Chủ tài khoản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chủ tài khoản:"
                android:textColor="#757575"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvDialogName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NGUYEN VAN A"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ngân hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ngân hàng:"
                android:textColor="#757575"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvDialogBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vietcombank"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Số tài khoản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số tài khoản:"
                android:textColor="#757575"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvDialogAccountNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1234567890"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Số tiền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số tiền rút:"
                android:textColor="#757575"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvDialogAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50,000đ"
                android:textColor="@color/color_chudao"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Thời gian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thời gian tạo:"
                android:textColor="#757575"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvDialogTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-05-25 14:30"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trạng thái:"
                android:textColor="#757575"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvDialogStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ xử lý"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Approved Section: Bill image -->
    <LinearLayout
        android:id="@+id/layoutDialogBill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hóa đơn chuyển khoản của Admin:"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
        <ImageView
            android:id="@+id/ivDialogBillImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="fitCenter"
            android:background="#EEEEEE"
            android:padding="2dp" />
    </LinearLayout>

    <!-- Rejected Section: Rejection Reason -->
    <LinearLayout
        android:id="@+id/layoutDialogRejection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lý do từ chối:"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/tvDialogRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFEBEE"
            android:padding="10dp"
            android:text="Sai thông tin số tài khoản"
            android:textColor="#D32F2F"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Re-create Button (Visible only if status == rejected) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRecreateRequest"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/custom_btn_muaangay"
        android:text="TẠO MỚI LẠI ĐƠN"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Close Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/custom_border_item_list"
        android:backgroundTint="#EEEEEE"
        android:text="ĐÓNG"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="15sp" />

</LinearLayout>
