<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Icon Container -->
        <ImageView
            android:id="@+id/iv_tx_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/custom_border_item_list"
            android:backgroundTint="#F0F4C3"
            android:padding="8dp"
            android:src="@drawable/baseline_credit_card_24_xanh"
            app:tint="#1E88E5" />

        <!-- Description and Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tx_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nạp tiền vào ví F"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tx_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2026-05-25 08:30"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:id="@+id/tv_tx_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+50,000đ"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
